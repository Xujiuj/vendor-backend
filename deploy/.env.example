# Vendor backend standalone delivery defaults.
REGISTRY=local
IMAGE_NAMESPACE=fx
IMAGE_TAG=latest

VENDOR_DB_URL=jdbc:sqlserver://127.0.0.1:1433;DatabaseName=vendor;encrypt=false;trustServerCertificate=true;SelectMethod=cursor
VENDOR_DB_USERNAME=sa
VENDOR_DB_PASSWORD=

FX_SQLSERVER_HOST=127.0.0.1,1433
FX_SQLSERVER_USER=sa
FX_SQLSERVER_PASSWORD=
FX_VENDOR_DATABASE=vendor

REDIS_HOST=vendor-redis
REDIS_PORT=6379
REDIS_PASSWORD=

VENDOR_BACKEND_PORT=18000
VENDOR_SNAIL_PORT=28080
VENDOR_PUBLIC_BASE_URL=https://vendor.example.com
VENDOR_BACKEND_JAVA_OPTS=

VENDOR_MONITOR_ENABLED=false
VENDOR_MONITOR_ADMIN_URL=http://monitor.example.com/admin
VENDOR_SNAIL_JOB_ENABLED=false
VENDOR_SNAIL_JOB_TOKEN=
VENDOR_SNAIL_JOB_SERVER_HOST=127.0.0.1
VENDOR_SNAIL_JOB_SERVER_PORT=17888

FX_LICENSE_SECRET_DIR=/opt/fx/secrets

VENDOR_CASHIER_BASE_URL=https://vendor.example.com/pay
VENDOR_PAYMENT_REQUIRE_SIGNATURE=true
VENDOR_WECHAT_PAY_ENABLED=false
VENDOR_WECHAT_APP_ID=
VENDOR_WECHAT_MERCHANT_ID=
VENDOR_WECHAT_NOTIFY_URL=
VENDOR_WECHAT_API_V3_KEY=
VENDOR_WECHAT_PLATFORM_CERTIFICATE=
VENDOR_ALIPAY_ENABLED=false
VENDOR_ALIPAY_APP_ID=
VENDOR_ALIPAY_SELLER_ID=
VENDOR_ALIPAY_NOTIFY_URL=
VENDOR_ALIPAY_PUBLIC_KEY=

FX_DOCKER_NETWORK=fx-delivery
